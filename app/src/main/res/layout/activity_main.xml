<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1565C0"
        app:title="Excess Baggage Fee"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimate excess baggage charges for your flight by filling in the details below."
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Select Ticket Class:"
                android:textStyle="bold"
                android:textColor="#111827"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spinnerTicketClass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/btn_dropdown"
                android:popupBackground="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Current Baggage Weight (kg):"
                android:textStyle="bold"
                android:textColor="#111827"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtBaggageWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="e.g. 45.0"
                android:inputType="numberDecimal"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Excess Baggage Rate / kg (RM):"
                android:textStyle="bold"
                android:textColor="#111827"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtRatePerKg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="e.g. 15.00"
                android:inputType="numberDecimal"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Calculate"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1565C0"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Reset"
                    android:textColor="#1565C0"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculation Results"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtExcessWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Weight: - kg"
                    android:textSize="15sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtExcessCharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Charge: RM 0.00"
                    android:textSize="15sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtTotalPayable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Amount Payable (+8% Tax): RM 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>